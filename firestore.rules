rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permite buscar por DNI sin estar logueado (recupero de contraseña)
    // Solo lectura del campo email/dni — sin exponer datos sensibles
    match /usuarios/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // El resto de colecciones requiere autenticación
    match /inscripciones/{docId} {
      allow read, write: if request.auth != null;
    }
    match /notas/{docId} {
      allow read, write: if request.auth != null;
    }
    match /eventos/{docId} {
      allow read, write: if request.auth != null;
    }
    match /comisiones/{docId} {
      allow read, write: if request.auth != null;
    }
    match /materias/{docId} {
      allow read, write: if request.auth != null;
    }
    match /planesEstudio/{docId} {
      allow read, write: if request.auth != null;
    }
    match /ofertaAcademica/{docId} {
      allow read, write: if request.auth != null;
    }

    // Lectura publica para mostrar las carreras en el formulario de registro
    match /carreras/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Oferta academica por comision (fuente real que ven los alumnos en Mis materias)
    match /comisionesOferta/{docId} {
      allow read, write: if request.auth != null;
    }

    // Cronograma de clases por comision (planificacion del profesor)
    match /cronogramas/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
