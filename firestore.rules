rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'admin_centro'];
    }

    // El alumno tiene su inscripcion guardada con id determinístico
    // "{uid}_{comisionId}", o el profesor es el dueño de la comision.
    function tieneAccesoComision(comisionId) {
      return exists(/databases/$(database)/documents/inscripciones/$(request.auth.uid + '_' + comisionId)) ||
        (exists(/databases/$(database)/documents/comisiones/$(comisionId)) &&
         get(/databases/$(database)/documents/comisiones/$(comisionId)).data.profesorUid == request.auth.uid);
    }

    // Permite buscar por DNI sin estar logueado (recupero de contraseña)
    // Solo lectura del campo email/dni — sin exponer datos sensibles
    match /usuarios/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == docId || esAdmin());
    }

    // El resto de colecciones requiere autenticación
    match /inscripciones/{docId} {
      allow read, write: if request.auth != null;
    }
    match /notas/{docId} {
      allow read, write: if request.auth != null;
    }
    match /eventos/{docId} {
      allow read, write: if request.auth != null;
    }
    match /comisiones/{docId} {
      allow read, write: if request.auth != null;
    }
    match /materias/{docId} {
      allow read, write: if request.auth != null;
    }
    match /planesEstudio/{docId} {
      allow read, write: if request.auth != null;
    }
    match /ofertaAcademica/{docId} {
      allow read, write: if request.auth != null;
    }

    // Lectura publica para mostrar las carreras en el formulario de registro
    match /carreras/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Oferta academica por comision (fuente real que ven los alumnos en Mis materias)
    match /comisionesOferta/{docId} {
      allow read, write: if request.auth != null;
    }

    // Cronograma de clases por comision (planificacion del profesor)
    match /cronogramas/{docId} {
      allow read, write: if request.auth != null;
    }

    // Tablero de tareas (kanban): solo accede quien es creador o fue invitado
    // como miembro. La creacion exige que el propio usuario quede en miembros.
    match /tareas/{docId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.miembros;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.miembros;
    }

    // Chat por comision: solo el profesor de esa comision y los alumnos
    // realmente inscritos pueden leer o mandar mensajes. No se editan ni
    // se borran mensajes una vez enviados.
    match /mensajesChat/{docId} {
      allow read: if request.auth != null && tieneAccesoComision(resource.data.comisionId);
      allow create: if request.auth != null
        && request.resource.data.autorUid == request.auth.uid
        && tieneAccesoComision(request.resource.data.comisionId);
    }
  }
}
